DATABASE_URL=postgresql://campaign:campaign@localhost:5433/campaign
PORT=8000
# --- added for the campaign engine ---
# NOTE: DATABASE_URL must be a standard postgresql:// URL (the app uses the Prisma pg driver adapter),
# e.g. postgresql://campaign:campaign@localhost:5432/campaign
REDIS_URL=redis://localhost:6379
LOG_LEVEL=info
# Worker tuning
CAMPAIGN_CONCURRENCY=2
MESSAGE_CONCURRENCY=10
NOTIFICATION_CONCURRENCY=5
MESSAGE_RATE_MAX=100
MESSAGE_RATE_WINDOW_MS=1000
EXPAND_BATCH_SIZE=500
STALLED_INTERVAL_MS=30000
# Retry policy (attempts includes the first try)
RETRY_ATTEMPTS=3
RETRY_BACKOFF_MS=2000
# Mock SMS provider
PROVIDER_FAILURE_RATE=0
PROVIDER_LATENCY_MS=30
PROVIDER_TIMEOUT_MS=5000
# JWT auth (required). Use a long random string, e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
# Set to production when serving over HTTPS; this enables the Secure cookie flag.
NODE_ENV=development